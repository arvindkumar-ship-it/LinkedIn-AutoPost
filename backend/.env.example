# LinkedIn Developer App (https://www.linkedin.com/developers/apps)
# Auth tab -> add redirect URL below. Products tab -> add "Sign In with LinkedIn using OpenID Connect"
# and "Share on LinkedIn" (gives you w_member_social without manual review).
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback

# Leave these two blank. They get filled automatically in db.json once you click
# "Connect LinkedIn" in the app and complete the OAuth flow.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

EVENT_NAME="HackFest 2026"
EVENT_TAGLINE="48-hour AI hackathon"
EVENT_AUDIENCE="students, startups, AI engineers"
EVENT_TONE="energetic, professional, slightly casual"
DEFAULT_HASHTAGS="#HackFest2026,#AI,#Hackathon"
